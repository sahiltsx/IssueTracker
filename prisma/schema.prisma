
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id                String    @id @default(cuid())
  email             String    
  password          String?
  image             String?
  emailVerified     String?
  githubId          String? @unique
  githubAccessToken String?
  createdAt         DateTime  @default(now())
}

model Otp {
  id        String    @id @default(cuid())
  email     String    @unique
  code      String  
  expiresAt DateTime
  attempts  Int       @default(0)
}